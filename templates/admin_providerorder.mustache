{{!
    @template local_aihub/admin_providerorder

    The administrator's page for the order the AI providers are tried in: a short introduction, the
    draggable list and the buttons that save it or go back to the automatic order.

    Context variables required for this template:
    * heading string Page heading, also the label of the list
    * intro string Introductory paragraph
    * actionurl string Form action URL
    * sesskey string Session key
    * savelabel string Label of the save button
    * resetlabel string Label of the button that goes back to the automatic order
    * hasown boolean Whether the administrator has chosen an order
    * providerorder object Context of the local_aihub/provider_order list

    Example context (json):
    {
        "heading": "Provider order",
        "intro": "Drag the providers to choose the order they are tried in.",
        "actionurl": "https://example.com/local/aihub/providerorder.php",
        "sesskey": "abc123",
        "savelabel": "Save order",
        "resetlabel": "Back to automatic",
        "hasown": true,
        "providerorder": {
            "listid": "aihub-providerorder-list", "inputid": "aihub-providerorder",
            "inputname": "providerorder", "labelid": "aihub-providerorder-label", "inputvalue": "groq,gemini",
            "items": [
                {"name": "groq", "label": "Groq", "movetitle": "Move Groq", "nokey": false, "nokeylabel": "No site key"},
                {"name": "gemini", "label": "Gemini", "movetitle": "Move Gemini", "nokey": true, "nokeylabel": "No site key"}
            ]
        }
    }
}}
<div class="local-aihub-providerorder-page">
    <h2 id="aihub-providerorder-label" class="h4">{{heading}}</h2>
    <p>{{intro}}</p>

    <form method="post" action="{{actionurl}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#providerorder}}
            {{>local_aihub/provider_order}}
        {{/providerorder}}
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">{{savelabel}}</button>
            {{#hasown}}
                <button type="submit" name="resetorder" value="1" class="btn btn-link">{{resetlabel}}</button>
            {{/hasown}}
        </div>
    </form>
</div>
